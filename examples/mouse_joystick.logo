; MOUSEPOS/MOUSEX/MOUSEY/BUTTON?: a passive mouse state query -- no
; pausing at all, unlike WAITKEY/INPUT. Continuously updated by moving
; the mouse over (and clicking on) the canvas, so this example only
; shows real values run from the actual app, not the headless test
; driver, where the mouse never moves and these just read their zero
; defaults.

PRINT MOUSEPOS   ; [x y], same coordinate space as POS/SETXY
PRINT BUTTON?    ; TRUE while a mouse button is held down over the canvas

TO followmouse
  ; WHILE, not self-recursion: this can run indefinitely (capped at
  ; 1,000,000 iterations, MAX_WHILE_ITERATIONS) without ever touching
  ; the 200-deep recursion cap a self-recursive followmouse would hit
  ; after 200 frames -- WHILE's loop body doesn't consume a real call
  ; stack level per iteration the way calling a procedure does.
  WHILE NOT BUTTON? [
    SETXY MOUSEX MOUSEY
  ]
END

; Joystick support (JOYSTICK?/JOYSTICKAXIS/JOYSTICKBUTTON?) used to be
; demonstrated here too. It was dropped from the language on 2026-08-12
; (see docs/ROADMAP.md's opening note), so this file now covers the
; mouse only.
